# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic | ollama
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:120b

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CHAT_URL=https://ollama.com/api/chat

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# Đổi thành true sau lần tải model đầu tiên để chạy hoàn toàn offline.
EMBEDDING_LOCAL_FILES_ONLY=false
CHROMA_COLLECTION=rag_documents_baai_bge_m3_1024

# Model thử nghiệm thêm, chưa dùng mặc định:
# EMBEDDING_MODEL=dangvantuan/vietnamese-embedding
# EMBEDDING_DIM=768

# Giữ model/cache trong workspace; thư mục .cache đã được gitignore.
HF_HOME=.cache/huggingface
TOKENIZERS_PARALLELISM=false

# Optional services
PAGEINDEX_API_KEY=
PAGEINDEX_TIMEOUT=30
JINA_API_KEY=

# Hiệu chỉnh ngày 2026-09-23 trên 15 in-domain + 5 out-of-domain queries.
SCORE_THRESHOLD=0.573
